      "alias": "foldersize",
      "note": "Mostra tamanho dos diretórios atuais",
      "shellTarget": "bash",
      "createdAt": "2026-07-28T23:50:32.906Z",
      "updatedAt": "2026-07-28T23:50:32.906Z"
    },
    {
      "title": "Ordenar pastas por tamanho",
      "content": "du -sh * | sort -h",
      "category": "bash-linux",
      "alias": "sortsize",
      "note": "Lista diretórios ordenados por tamanho",
      "shellTarget": "bash",
      "createdAt": "2026-07-28T23:50:32.906Z",
      "updatedAt": "2026-07-28T23:50:32.906Z"
    },
    {
      "title": "Ver processos ativos",
      "content": "ps aux",
      "category": "bash-linux",
      "alias": "process",
      "note": "Lista processos em execução",
      "shellTarget": "bash",
      "createdAt": "2026-07-28T23:50:32.906Z",
      "updatedAt": "2026-07-28T23:50:32.906Z"
    },
    {
      "title": "Buscar processo",
      "content": "ps aux | grep nome",
