{
  "name": "bucket-command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bucket-command": "./apps/cli/dist/bin.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @bucket-command/desktop",
    "desktop:start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron --no-sandbox apps/desktop",
    "e2e": "node apps/desktop/e2e/dashboard.e2e.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@bucket-command/cli": "file:apps/cli",
    "@bucket-command/desktop": "file:apps/desktop",
    "better-sqlite3": "^13.0.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
